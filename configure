#!/usr/bin/env bash

PYTHON_VERSION=3.14

main () {
    set -e
    sanity_check
    create_virtualenv
    install_requirements
}

sanity_check () {
    which uv >/dev/null \
        || (
            echo "You have to install uv first: https://docs.astral.sh/uv/"
            exit 1
            )
}

create_virtualenv () {
    uv venv --python "$PYTHON_VERSION"
}

install_requirements () {
    uv pip sync dev-requirements.txt
}

if [[ $BASH_SOURCE = $0 ]]; then
    main
fi
